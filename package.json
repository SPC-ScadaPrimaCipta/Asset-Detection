{
  "name": "asset-detection",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "worker": "tsx --env-file=.env.local workers/detection-worker.ts",
    "worker:legacy": "ts-node --project tsconfig.worker.json -r tsconfig-paths/register workers/detection-worker.ts",
    "migrate": "node scripts/migrate.cjs",
    "migrate:standards": "tsx --env-file=.env.local scripts/migrate-standards.ts",
    "migrate:knowledge": "tsx --env-file=.env.local scripts/migrate-knowledge.ts",
    "seed:standards": "tsx --env-file=.env.local scripts/seed-standards.ts",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "cleanup": "ts-node --project tsconfig.worker.json -r tsconfig-paths/register scripts/cleanup-storage.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@phosphor-icons/react": "^2.1.10",
    "@types/uuid": "^10.0.0",
    "bullmq": "^6.3.6",
    "dotenv": "16.4.5",
    "exceljs": "^4.4.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.45.0",
    "mupdf": "^1.28.1",
    "next": "16.3.5",
    "openai": "^7.15.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.0.379",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/jest": "^29.5.14",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "jest": "^29.7.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.2.6",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
