# ─────────────────────────────────────────────────────────────────────────────
# TagFlow (v3.5) — Environment Variables
#
# Salin berkas ini ke `.env.local`:
#   cp .env.example .env.local
# ─────────────────────────────────────────────────────────────────────────────

# ── Database & Infrastructure ────────────────────────────────────────────────
# URL koneksi PostgreSQL (Wajib)
DATABASE_URL=postgresql://postgres:password@localhost:5432/asset_detection

# URL koneksi Redis untuk antrean background worker BullMQ (Wajib)
REDIS_URL=redis://localhost:6379

# Direktori penyimpanan file lokal (PDF dan crop simbol)
STORAGE_PATH=./storage

# ── Autentikasi & Keamanan Sesi ──────────────────────────────────────────────
# Kunci rahasia untuk menandatangani cookie sesi JWT (Minimal 32 karakter)
AUTH_SECRET=ganti-dengan-kunci-rahasia-jwt-acak-minimal-32-karakter-2026

# ── AI Provider & API Keys ───────────────────────────────────────────────────
# Provider AI utama: 'gemini' (rekomendasi vision), 'openai', 'anthropic', atau 'deepseek'
AI_PROVIDER=gemini

# Google Gemini API Key (Bisa juga diatur lewat menu Settings di web)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Batas request per menit untuk Google Gemini (15 untuk free-tier, naikkan jika pakai paid plan)
GEMINI_REQUESTS_PER_MINUTE=15

# ── Provider Alternatif (Opsional) ───────────────────────────────────────────
# DeepSeek (Text-only)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-7-sonnet-20250219

# ── Background Worker & Server ───────────────────────────────────────────────
# Konkurensi worker pemrosesan deteksi (Default: 1 agar aman kuota rate limit)
WORKER_CONCURRENCY=1

# Port server Next.js (Default: 3000)
PORT=3000

# Catatan: Seluruh parameter tuning lanjutan (ambang batas confidence, NMS IoU,
# token limits, circuit breaker) sudah memiliki nilai bawaan optimal dan dapat
# diubah langsung melalui halaman web Settings tanpa perlu restart server.
