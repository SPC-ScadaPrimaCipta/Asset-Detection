# Environment Variables

## Database
DB_SERVER=localhost
DB_DATABASE=promia
DB_USER=sa
DB_PASSWORD=your_password
DB_TRUST_CERT=false

## Storage Backend
# Options: local, s3, sharepoint
STORAGE_BACKEND=local
PFD_STORAGE_PATH=./storage/pfd

# S3 (if using S3)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=promia
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# SharePoint (if using SharePoint)
SHAREPOINT_SITE_URL=https://tenant.sharepoint.com/sites/promia
SHAREPOINT_DRIVE_ID=your_drive_id

## NextAuth
NEXTAUTH_SECRET=your_secret_here_min_32_chars
NEXTAUTH_URL=http://localhost:3003

## Job Worker
WORKER_POLL_INTERVAL=3000
WORKER_ENABLED=true
